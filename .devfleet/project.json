{
  "schema_version": 1,
  "id": "common-tools",
  "repository": {
    "owner": "juhon",
    "name": "common-tools",
    "branch": "codex/native-connectors-alignment"
  },
  "stack": "node",
  "reviewed": true,
  "automatic_ci": true,
  "toolchain": {
    "node": "22.23.4",
    "npm": "10.9.2"
  },
  "inputs": [
    ".devfleet/project.json",
    "package.json",
    "package-lock.json",
    ".devfleet/platform_checks.py"
  ],
  "setup": [
    {
      "name": "dotnet-sdk",
      "argv": [
        "{python}",
        "-c",
        "import os,pathlib,subprocess; root=pathlib.Path(os.environ.get('DOTNET_ROOT','')); exe=root/('dotnet.exe' if os.name=='nt' else 'dotnet'); version=subprocess.check_output([str(exe),'--version'],text=True).strip(); print('DEVFOUNDRY_DOTNET_VERSION='+version); raise SystemExit(0 if root.is_absolute() and version.startswith('8.') else 'Configured .NET 8 SDK is unavailable')"
      ]
    },
    {
      "name": "dependencies",
      "argv": [
        "{node}",
        "{npm_cli}",
        "ci",
        "--no-audit",
        "--no-fund",
        "--ignore-scripts"
      ]
    }
  ],
  "checks": [
    {
      "name": "test-portable",
      "argv": [
        "{node}",
        "{npm_cli}",
        "run",
        "test:portable"
      ]
    },
    {
      "name": "windows-business-gates",
      "argv": [
        "{python}",
        ".devfleet/platform_checks.py",
        "windows-full",
        "--node",
        "{node}",
        "--npm-cli",
        "{npm_cli}"
      ]
    },
    {
      "name": "linux-recovery",
      "argv": [
        "{python}",
        ".devfleet/platform_checks.py",
        "linux-recovery",
        "--node",
        "{node}",
        "--npm-cli",
        "{npm_cli}"
      ]
    },
    {
      "name": "workflow-lint",
      "argv": [
        "{python}",
        ".devfleet/platform_checks.py",
        "workflow-lint",
        "--node",
        "{node}",
        "--npm-cli",
        "{npm_cli}"
      ]
    }
  ],
  "runners": {
    "windows": "common-tools-windows",
    "linux": "common-tools-linux"
  },
  "resource_group": "native",
  "timeout_seconds": 3600,
  "clear_env": [],
  "deployment": {
    "enabled": false
  }
}
