{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills/pd-hifi-slideclone/deck-ir.schema.json",
  "title": "Editable Deck Intermediate Representation",
  "type": "object",
  "required": ["version", "slideSize", "pages"],
  "properties": {
    "version": { "const": "1.0" },
    "slideSize": {
      "type": "object",
      "required": ["widthPt", "heightPt"],
      "properties": {
        "widthPt": { "type": "number" },
        "heightPt": { "type": "number" }
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "box": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number" },
        "h": { "type": "number" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["pageImage", "evidenceBox"],
      "properties": {
        "pageImage": { "type": "string" },
        "ocrProvider": { "type": "string" },
        "visionProvider": { "type": "string" },
        "confidence": { "type": "number" },
        "evidenceBox": { "$ref": "#/$defs/box" },
        "editable": { "type": "boolean" },
        "nonEditableReason": { "type": "string" },
        "reconstruction": { "$ref": "#/$defs/reconstruction" }
      },
      "additionalProperties": true
    },
    "canonicalCanvas": {
      "type": "object",
      "required": ["widthPx", "heightPx", "sha256"],
      "properties": {
        "widthPx": { "type": "integer", "minimum": 1 },
        "heightPx": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "reconstruction": {
      "type": "object",
      "required": ["contractVersion", "family", "realization", "sourceSufficiency", "boundaryState", "zOrderRole"],
      "properties": {
        "contractVersion": { "const": "1.0" },
        "family": { "enum": ["text", "graphic", "data", "geometry", "scene", "unknown"] },
        "realization": { "enum": ["native_text", "native_shape", "native_table", "native_chart", "source_crop", "registered_image_layer", "manual_required"] },
        "sourceSufficiency": { "enum": ["sufficient", "reconstructable", "insufficient", "unknown"] },
        "boundaryState": { "enum": ["complete", "partial", "occluded", "contaminated", "unknown"] },
        "zOrderRole": { "enum": ["base", "midground", "subject", "foreground", "source_graphic", "native"] },
        "canonicalPageSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "canonicalCanvas": { "$ref": "#/$defs/canonicalCanvas" },
        "registrationGroupId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$" },
        "identityVerifiable": { "type": "boolean" },
        "dataVerifiable": { "type": "boolean" },
        "reconstructedPixels": { "type": "boolean" },
        "manualRequiredReason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "textBox": {
      "type": "object",
      "required": ["id", "text", "box", "source"],
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string" },
        "text": { "type": "string" },
        "box": { "$ref": "#/$defs/box" },
        "font": {
          "type": "object",
          "properties": {
            "family": { "type": "string" },
            "sizePt": { "type": "number" },
            "weight": { "type": "string" },
            "color": { "type": "string" },
            "align": { "type": "string" }
          },
          "additionalProperties": true
        },
        "source": { "$ref": "#/$defs/source" }
      },
      "additionalProperties": true
    },
    "nativeChartPayload": {
      "type": "object",
      "required": ["schemaVersion", "fallbackSignature", "fallbackSha256", "dataVerified", "workbook"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "fallbackSignature": { "type": "string", "minLength": 1, "maxLength": 1048576 },
        "fallbackSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "dataVerified": { "const": true },
        "workbook": {
          "type": "object",
          "required": ["sheetName"],
          "properties": { "sheetName": { "type": "string", "minLength": 1, "maxLength": 31 } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "visualElement": {
      "type": "object",
      "required": ["id", "type", "box", "source"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "box": { "$ref": "#/$defs/box" },
        "style": { "type": "object" },
        "assetPath": { "type": "string" },
        "categories": { "type": "array", "items": { "type": "string" }, "maxItems": 10000 },
        "values": { "type": "array", "items": { "type": "number" }, "maxItems": 10000 },
        "series": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["values"],
            "properties": {
              "name": { "type": "string" },
              "values": { "type": "array", "items": { "type": "number" }, "maxItems": 10000 }
            },
            "additionalProperties": true
          }
        },
        "nativePayload": { "$ref": "#/$defs/nativeChartPayload" },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "source": { "$ref": "#/$defs/source" }
      },
      "additionalProperties": true
    },
    "page": {
      "type": "object",
      "required": ["pageIndex", "sourceImage", "textBoxes", "shapes", "images", "tables", "charts", "icons"],
      "properties": {
        "pageIndex": { "type": "integer" },
        "sourceImage": { "type": "string" },
        "reconstruction": {
          "type": "object",
          "required": ["contractVersion", "sourceImageAvailable"],
          "properties": {
            "contractVersion": { "const": "1.0" },
            "canonicalPageSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "canonicalCanvas": { "$ref": "#/$defs/canonicalCanvas" },
            "sourceImageAvailable": { "type": "boolean" },
            "allowCanonicalMedia": { "type": "boolean" },
            "allowCanonicalMediaReason": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "background": { "type": "object" },
        "textBoxes": {
          "type": "array",
          "items": { "$ref": "#/$defs/textBox" }
        },
        "shapes": {
          "type": "array",
          "items": { "$ref": "#/$defs/visualElement" }
        },
        "images": {
          "type": "array",
          "items": { "$ref": "#/$defs/visualElement" }
        },
        "tables": {
          "type": "array",
          "items": { "$ref": "#/$defs/visualElement" }
        },
        "charts": {
          "type": "array",
          "items": { "$ref": "#/$defs/visualElement" }
        },
        "icons": {
          "type": "array",
          "items": { "$ref": "#/$defs/visualElement" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
