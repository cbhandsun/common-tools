{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills/pd-hifi-slideclone/slideclone.config.schema.json",
  "title": "Slide Clone Pipeline Config",
  "type": "object",
  "required": ["inputDir", "outputDir", "adapters", "thresholds"],
  "properties": {
    "inputDir": { "type": "string", "minLength": 1 },
    "outputDir": { "type": "string", "minLength": 1 },
    "pagePattern": { "type": "string", "default": "*.{png,jpg,jpeg,webp,pdf,pptx}" },
    "pageConcurrency": { "type": "integer", "default": 2, "minimum": 1, "maximum": 8 },
    "slide": {
      "type": "object",
      "properties": {
        "widthPt": { "type": "number", "default": 960, "exclusiveMinimum": 0 },
        "heightPt": { "type": "number", "default": 540, "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "adapters": {
      "type": "object",
      "required": ["ocr", "vision", "pptx", "render", "diff"],
      "properties": {
        "normalize": { "type": "string" },
        "ocr": { "type": "string" },
        "vision": { "type": "string" },
        "pptx": { "type": "string" },
        "render": { "type": "string" },
        "diff": { "type": "string" },
        "compare": { "type": "string" },
        "polish": { "type": "string" },
        "compress": { "type": "string" }
      },
      "additionalProperties": false
    },
    "regionProposal": {
      "type": "object",
      "properties": {
        "includeFullPage": { "type": "boolean", "default": true },
        "emitRegionPages": { "type": "boolean", "default": false },
        "cropContainer": { "type": "boolean", "default": false },
        "minConfidence": { "type": "number", "default": 0.45 },
        "minAreaRatio": { "type": "number", "default": 0.035 },
        "maxAreaRatio": { "type": "number", "default": 0.72 },
        "paddingPx": { "type": "integer", "default": 4 },
        "innerPaddingPx": { "type": "integer", "default": 4 },
        "innerHeaderSkipRatio": { "type": "number", "default": 0.18 }
      },
      "additionalProperties": false
    },
    "normalize": {
      "type": "object",
      "properties": {
        "exportWidthPx": { "type": "integer", "default": 1920, "minimum": 320 },
        "exportHeightPx": { "type": "integer", "default": 1080, "minimum": 180 },
        "maxPages": { "type": "integer", "default": 0, "minimum": 0, "maximum": 10000 }
      },
      "additionalProperties": false
    },
    "powerPoint": {
      "type": "object",
      "properties": {
        "cleanupHidden": {
          "type": "boolean",
          "default": false,
          "description": "Deprecated compatibility field. SlideClone never terminates PowerPoint processes it does not own."
        }
      },
      "additionalProperties": false
    },
    "compress": {
      "type": "object",
      "properties": {
        "jpegQuality": { "type": "integer", "default": 88, "minimum": 1, "maximum": 95 },
        "pngCompressLevel": { "type": "integer", "default": 9, "minimum": 0, "maximum": 9 },
        "maxImagePixels": { "type": "integer", "default": 0, "minimum": 0 },
        "minSavingBytes": { "type": "integer", "default": 128, "minimum": 0 }
      },
      "additionalProperties": false
    },
    "diff": {
      "type": "object",
      "properties": {
        "foregroundTolerancePx": { "type": "integer", "default": 2, "minimum": 0, "maximum": 8 },
        "foregroundToleranceDelta": { "type": "number", "default": 54, "minimum": 0 }
      },
      "additionalProperties": false
    },
    "fontFit": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "candidates": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["Microsoft YaHei", "SimHei", "DengXian", "Arial"]
        }
      },
      "additionalProperties": false
    },
    "textOcr": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "adapter": { "type": "string" },
        "mode": { "type": "string", "enum": ["anchored", "fullPage"], "default": "anchored" },
        "paddingPt": { "type": "number", "default": 2, "minimum": 0 },
        "upscale": { "type": "integer", "default": 3, "minimum": 1, "maximum": 6 },
        "psm": { "type": ["integer", "string"], "default": 6 },
        "preprocess": { "type": "boolean", "default": true },
        "microBatch": { "type": "boolean", "default": true },
        "microBatchSize": { "type": "integer", "default": 8, "minimum": 1, "maximum": 16 }
      },
      "additionalProperties": false
    },
    "tesseract": {
      "type": "object",
      "properties": {
        "bin": { "type": "string" },
        "lang": { "type": "string", "default": "chi_sim+eng" },
        "tessdataPrefix": { "type": "string" },
        "psm": { "type": ["integer", "string"], "default": 6 },
        "timeoutMs": { "type": "integer", "default": 120000, "minimum": 1000, "maximum": 600000 }
      },
      "additionalProperties": false
    },
    "umiOcr": {
      "type": "object",
      "properties": {
        "paddleBin": { "type": "string" },
        "modelsPath": { "type": "string" },
        "initTimeoutMs": { "type": "integer", "default": 60000, "minimum": 1000, "maximum": 600000 },
        "timeoutMs": { "type": "integer", "default": 120000, "minimum": 1000, "maximum": 600000 },
        "idleTimeoutMs": { "type": "integer", "default": 30000, "minimum": 1000, "maximum": 600000 },
        "maxOutputBytes": { "type": "integer", "default": 33554432, "minimum": 1048576, "maximum": 67108864 },
        "cache": { "type": ["boolean", "string"] },
        "cacheDir": { "type": "string" }
      },
      "additionalProperties": false
    },
    "paddleOcr": {
      "type": "object",
      "properties": {
        "pythonBin": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "workerScript": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "lang": { "type": "string", "default": "ch", "pattern": "^[A-Za-z0-9_-]{2,32}$" },
        "ocrVersion": { "type": "string", "default": "PP-OCRv6", "pattern": "^PP-OCRv[3-9]$" },
        "device": { "type": "string", "pattern": "^[A-Za-z0-9:_,-]{1,64}$" },
        "engine": { "type": "string", "enum": ["paddle", "paddle_static", "paddle_dynamic", "transformers", "onnxruntime"] },
        "cpuThreads": { "type": "integer", "minimum": 1, "maximum": 128 },
        "textDetectionModel": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$" },
        "textRecognitionModel": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$" },
        "textDetectionModelDir": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "textRecognitionModelDir": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "modelCacheDir": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "enableHpi": { "type": "boolean", "default": false },
        "useTextlineOrientation": { "type": "boolean", "default": false },
        "initTimeoutMs": { "type": "integer", "default": 180000, "minimum": 1000, "maximum": 600000 },
        "timeoutMs": { "type": "integer", "default": 120000, "minimum": 1000, "maximum": 600000 },
        "idleTimeoutMs": { "type": "integer", "default": 30000, "minimum": 1000, "maximum": 600000 },
        "maxOutputBytes": { "type": "integer", "default": 33554432, "minimum": 1048576, "maximum": 67108864 },
        "cache": { "type": ["boolean", "string"] },
        "cacheDir": { "type": "string", "minLength": 1, "maxLength": 32768 }
      },
      "additionalProperties": false
    },
    "containerStyleFit": { "type": "object", "additionalProperties": true },
    "textMicroAdjust": { "type": "object", "additionalProperties": true },
    "openXmlBuilder": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configuration": { "type": "string", "enum": ["Debug", "Release", "debug", "release"] },
        "exePath": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "powerPointSafe": { "type": "boolean" },
        "cache": { "type": ["boolean", "string"] },
        "cacheDir": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "cacheMaxBytes": { "type": "integer", "minimum": 1048576, "maximum": 1099511627776 },
        "batchConcurrency": { "type": "integer", "minimum": 1, "maximum": 8 },
        "retainBuildArtifacts": { "type": "boolean" },
        "targetFramework": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.-]+$" }
      }
    },
    "python": { "type": "object", "additionalProperties": true },
    "render": { "type": "object", "additionalProperties": true },
    "searchTextOcr": { "type": "object", "additionalProperties": true },
    "thresholds": {
      "type": "object",
      "properties": {
        "pixelDiffRatio": { "type": "number", "default": 0.08 },
        "foregroundMissingRatio": { "type": "number", "default": 0.12 },
        "layoutMeanIoU": { "type": "number", "default": 0.86 },
        "textCoverage": { "type": "number", "default": 0.95 },
        "maxCriticalOffsetPt": { "type": "number", "default": 8 },
        "maxOutOfBoundsPt": { "type": "number", "default": 1 },
        "maxImageAspectRatioDelta": { "type": "number", "default": 0.03 },
        "maxRasterImageAreaRatio": { "type": "number", "default": 0.25 }
      },
      "additionalProperties": false
    },
    "maxIterations": { "type": "integer", "default": 2, "minimum": 0 },
    "postprocess": {
      "type": "object",
      "properties": {
        "compare": { "type": "boolean", "default": true },
        "polish": { "type": "boolean", "default": true },
        "compress": { "type": "boolean", "default": true },
        "verifyCompressed": { "type": "boolean", "default": true },
        "stopWhenThresholdPassed": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
