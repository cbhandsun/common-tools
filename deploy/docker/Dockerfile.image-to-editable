FROM mcr.microsoft.com/dotnet/sdk:8.0-bookworm-slim AS openxml-builder

WORKDIR /src
COPY skills/pd-hifi-slideclone/dotnet/OpenXmlDeckBuilder/OpenXmlDeckBuilder.csproj skills/pd-hifi-slideclone/dotnet/OpenXmlDeckBuilder/packages.lock.json ./OpenXmlDeckBuilder/
RUN dotnet restore ./OpenXmlDeckBuilder/OpenXmlDeckBuilder.csproj --locked-mode
COPY skills/pd-hifi-slideclone/dotnet/OpenXmlDeckBuilder ./OpenXmlDeckBuilder
RUN dotnet publish ./OpenXmlDeckBuilder/OpenXmlDeckBuilder.csproj --configuration Release --no-restore --output /opt/openxml

FROM node:22-bookworm-slim

WORKDIR /app
RUN apt-get update \
    && apt-get install --yes --no-install-recommends libicu72 libssl3 \
    && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY packages ./packages
# Keep the runtime image independent from a second remote base image.  The SDK
# stage already contains the exact runtime used to publish OpenXmlDeckBuilder;
# copy only the runtime host and shared framework, never the SDK itself.
COPY --from=openxml-builder /usr/share/dotnet/dotnet /usr/share/dotnet/dotnet
COPY --from=openxml-builder /usr/share/dotnet/host /usr/share/dotnet/host
COPY --from=openxml-builder /usr/share/dotnet/shared /usr/share/dotnet/shared
COPY --from=openxml-builder /opt/openxml /opt/openxml

ENV DOTNET_ROOT=/usr/share/dotnet
ENV PATH=/usr/share/dotnet:${PATH}
ENV OPENXML_BUILDER_EXE=/opt/openxml/OpenXmlDeckBuilder

RUN npm ci --omit=dev --ignore-scripts \
    && useradd --create-home --uid 10001 worker \
    && chown -R worker:worker /app /opt/openxml
USER worker
CMD ["node", "packages/cli/bin/common-tools.js"]
