FROM node:22-bookworm-slim

WORKDIR /app
COPY package.json package-lock.json ./
COPY packages ./packages
RUN npm ci --omit=dev --ignore-scripts && useradd --create-home --uid 10001 appuser && chown -R appuser:appuser /app
USER appuser
EXPOSE 3000
CMD ["node", "packages/remote-mcp-server/bin/common-tools-remote-mcp.js"]
