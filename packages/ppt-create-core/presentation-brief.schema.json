{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://common-tools.local/schemas/presentation-brief-1.0.json",
  "title": "PresentationBrief 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "audience", "purpose", "sections"],
  "properties": {
    "version": { "const": "1.0" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "subtitle": { "type": "string", "minLength": 1, "maxLength": 320 },
    "audience": { "type": "string", "minLength": 1, "maxLength": 160 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 320 },
    "language": { "type": "string", "minLength": 1, "maxLength": 32 },
    "theme": { "enum": ["clean-light-v1", "executive-dark-v1", "editorial-warm-v1", "technical-blue-v1"] },
    "seed": { "$ref": "#/$defs/safeId" },
    "variantCount": { "type": "integer", "minimum": 1, "maximum": 3 },
    "maxSlides": { "type": "integer", "minimum": 2, "maximum": 100 },
    "sections": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "$ref": "#/$defs/section" } },
    "closing": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 80 } }
  },
  "$defs": {
    "safeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
    "point": { "type": "object", "additionalProperties": false, "required": ["label"], "properties": { "id": { "$ref": "#/$defs/safeId" }, "label": { "type": "string", "minLength": 1, "maxLength": 80 }, "detail": { "type": "string", "minLength": 1, "maxLength": 240 }, "value": { "type": "string", "minLength": 1, "maxLength": 40 }, "required": { "type": "boolean" } } },
    "section": { "type": "object", "additionalProperties": false, "required": ["title", "points"], "properties": { "id": { "$ref": "#/$defs/safeId" }, "title": { "type": "string", "minLength": 1, "maxLength": 120 }, "summary": { "type": "string", "minLength": 1, "maxLength": 500 }, "mode": { "enum": ["narrative", "metrics", "comparison", "process"] }, "points": { "type": "array", "minItems": 1, "maxItems": 48, "items": { "$ref": "#/$defs/point" } } } }
  }
}
