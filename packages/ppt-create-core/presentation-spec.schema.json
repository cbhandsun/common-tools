{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://common-tools.local/schemas/presentation-spec-1.0.json",
  "title": "PresentationSpec 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "slides"],
  "properties": {
    "version": { "const": "1.0" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "subtitle": { "type": "string", "minLength": 1, "maxLength": 320 },
    "audience": { "type": "string", "minLength": 1, "maxLength": 160 },
    "language": { "type": "string", "minLength": 1, "maxLength": 32 },
    "theme": { "enum": ["clean-light-v1", "executive-dark-v1", "editorial-warm-v1", "technical-blue-v1"] },
    "seed": { "$ref": "#/$defs/safeId" },
    "variantCount": { "type": "integer", "minimum": 1, "maximum": 3 },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/slide" }
    }
  },
  "$defs": {
    "safeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "value": { "type": "string", "minLength": 1, "maxLength": 40 },
        "detail": { "type": "string", "minLength": 1, "maxLength": 240 },
        "required": { "type": "boolean" }
      }
    },
    "mediaVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mediaType", "alt"],
      "properties": {
        "kind": { "const": "media" },
        "mediaType": { "enum": ["image", "illustration", "icon"] },
        "alt": { "type": "string", "minLength": 1, "maxLength": 240 },
        "caption": { "type": "string", "minLength": 1, "maxLength": 160 },
        "assetId": { "$ref": "#/$defs/safeId" },
        "fit": { "enum": ["contain", "cover"] }
      }
    },
    "tableVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "headers", "rows"],
      "properties": {
        "kind": { "const": "table" },
        "headers": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
        "rows": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 120 } } },
        "insight": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "chartVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "type", "categories", "series"],
      "properties": {
        "kind": { "const": "chart" },
        "type": { "enum": ["bar", "column", "line", "pie", "donut"] },
        "categories": { "type": "array", "minItems": 2, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
        "series": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["name", "values"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 80 }, "values": { "type": "array", "minItems": 2, "maxItems": 12, "items": { "type": "number", "minimum": -1000000000, "maximum": 1000000000 } } } } },
        "insight": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "analysisVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "model", "entries"],
      "properties": {
        "kind": { "const": "analysis" },
        "model": { "enum": ["swot", "quadrant", "funnel", "timeline"] },
        "entries": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": { "id": { "$ref": "#/$defs/safeId" }, "label": { "type": "string", "minLength": 1, "maxLength": 80 }, "detail": { "type": "string", "minLength": 1, "maxLength": 180 }, "group": { "type": "string", "minLength": 1, "maxLength": 24 } } } },
        "insight": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "visual": { "oneOf": [{ "$ref": "#/$defs/mediaVisual" }, { "$ref": "#/$defs/tableVisual" }, { "$ref": "#/$defs/chartVisual" }, { "$ref": "#/$defs/analysisVisual" }] },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "role": { "enum": ["cover", "section", "content", "metrics", "comparison", "process", "closing"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "priority": { "enum": ["narrative", "metrics", "comparison", "process", "action"] },
        "layout": { "enum": ["cover-signal-v1", "cover-band-v1", "section-band-v1", "section-index-v1", "content-cards-v1", "content-editorial-v1", "metrics-row-v1", "metrics-focus-v1", "comparison-split-v1", "comparison-axis-v1", "process-linear-v1", "process-stages-v1", "closing-centered-v1", "closing-actions-v1", "media-frame-v1", "media-caption-v1", "table-focus-v1", "table-compact-v1", "chart-focus-v1", "chart-insight-v1", "analysis-canvas-v1", "analysis-steps-v1"] },
        "visual": { "$ref": "#/$defs/visual" },
        "items": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/item" } }
      },
      "allOf": [
        { "if": { "properties": { "role": { "enum": ["cover"] } } }, "then": { "properties": { "items": { "maxItems": 0 } } } },
        { "if": { "properties": { "role": { "enum": ["section", "closing"] } } }, "then": { "properties": { "items": { "maxItems": 3 } } } },
        { "if": { "properties": { "role": { "const": "content" } } }, "then": { "required": ["items"], "properties": { "items": { "minItems": 1, "maxItems": 6 } } } },
        { "if": { "properties": { "role": { "const": "metrics" } } }, "then": { "required": ["items"], "properties": { "items": { "minItems": 2, "maxItems": 4 } } } },
        { "if": { "properties": { "role": { "const": "comparison" } } }, "then": { "required": ["items"], "properties": { "items": { "minItems": 2, "maxItems": 2 } } } },
        { "if": { "properties": { "role": { "const": "process" } } }, "then": { "required": ["items"], "properties": { "items": { "minItems": 2, "maxItems": 6 } } } }
      ]
    }
  }
}
